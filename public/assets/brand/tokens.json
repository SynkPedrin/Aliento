{
  "$description": "Alento · design tokens do app. Valores em px (1 px = 1 pt no iOS = 1 dp no Android). Fonte: identidade oficial e mockups da apresentação.",
  "color": {
    "brand": {
      "folego":  { "value": "#1E3FFF", "role": "Azul Fôlego · cor primária, botões, destaques" },
      "noite":   { "value": "#0A0F3C", "role": "Azul Noite · texto principal, fundos escuros" },
      "menta":   { "value": "#3EE0B5", "role": "Menta · o sol, acento positivo, CTA secundário" },
      "nevoa":   { "value": "#B9C8FF", "role": "Névoa · apoio, texto sobre azul" },
      "ar":      { "value": "#EEF3FF", "role": "Ar · fundos de cartão e de tela" },
      "branco":  { "value": "#FFFFFF", "role": "Branco · fundo padrão do app" }
    },
    "support": {
      "respiracao":      { "value": "#8E9DFF", "role": "Curva da respiração" },
      "respiracaoNoite": { "value": "#4A5BC4", "role": "Respiração sobre fundo escuro" },
      "textoApoio":      { "value": "#4A5185", "role": "Texto secundário" },
      "linha":           { "value": "#D5DCF5", "role": "Bordas e divisores" }
    },
    "program": {
      "semFumo":   { "value": "#3EE0B5", "role": "Programa Sem Fumo (Menta)" },
      "alcool":    { "value": "#9B8CFF", "role": "Programa Álcool (Lavanda)" },
      "acucar":    { "value": "#FF7A59", "role": "Programa Açúcar (Coral)" },
      "ansiedadeSono": { "value": "#FFC857", "role": "Programas Ansiedade e Sono (Âmbar)" }
    },
    "semantic": {
      "background":      { "value": "{color.brand.branco}" },
      "surface":         { "value": "{color.brand.ar}" },
      "textPrimary":     { "value": "{color.brand.noite}" },
      "textSecondary":   { "value": "{color.support.textoApoio}" },
      "textOnBrand":     { "value": "{color.brand.branco}" },
      "textOnBrandMuted":{ "value": "{color.brand.nevoa}" },
      "primary":         { "value": "{color.brand.folego}" },
      "accent":          { "value": "{color.brand.menta}" },
      "border":          { "value": "{color.support.linha}" },
      "streakDone":      { "value": "{color.brand.menta}", "note": "Dia sem o hábito" },
      "streakRestart":   { "value": "{color.support.respiracao}", "note": "Recomeço após recaída: nunca vermelho, nunca erro" }
    }
  },
  "font": {
    "family": {
      "display": { "value": "Varela", "note": "Só peso Regular 400. Títulos, números grandes, marca. Hierarquia por tamanho, nunca negrito." },
      "text":    { "value": "Figtree", "weights": [300, 400, 500, 600], "note": "Texto, interface, botões." }
    },
    "scale": {
      "display": { "family": "Varela",  "size": 66, "lineHeight": 0.9,  "letterSpacing": "-0.03em", "use": "Contador de dias" },
      "h1":      { "family": "Varela",  "size": 38, "lineHeight": 1.05, "letterSpacing": "-0.02em", "use": "Título de tela de destaque" },
      "h2":      { "family": "Varela",  "size": 28, "lineHeight": 1.15, "letterSpacing": "-0.01em", "use": "Título de tela" },
      "h3":      { "family": "Varela",  "size": 19, "lineHeight": 1.2,  "use": "Título de cartão" },
      "body":    { "family": "Figtree", "size": 15, "weight": 300, "lineHeight": 1.45 },
      "bodyStrong": { "family": "Figtree", "size": 15, "weight": 500, "lineHeight": 1.45 },
      "button":  { "family": "Figtree", "size": 16, "weight": 500, "lineHeight": 1 },
      "caption": { "family": "Figtree", "size": 12, "weight": 400, "lineHeight": 1.3 },
      "overline":{ "family": "Figtree", "size": 11, "weight": 500, "letterSpacing": "0.14em", "textTransform": "uppercase" }
    }
  },
  "radius": {
    "chip": 20, "option": 16, "card": 22, "button": 30, "sheet": 28, "icon": "22.5%"
  },
  "spacing": {
    "screenPaddingX": 22, "stackGap": 14, "cardPadding": 18, "tabBarHeight": 84, "statusBar": 54
  },
  "shadow": {
    "floating": "0 30px 60px -20px rgba(10,15,60,0.35)",
    "note": "Sombras raras e suaves. Nada de sombra pesada."
  },
  "motion": {
    "easeOut": "cubic-bezier(.22,.7,.12,1)",
    "easeInOut": "cubic-bezier(.65,0,.35,1)",
    "breath": { "inhale": "4s", "exhale": "4s", "note": "Animações de respiração e do sol seguem 8 s por ciclo" },
    "durations": { "fast": "250ms", "base": "600ms", "slow": "1100ms" },
    "reducedMotion": "Respeitar a preferência do sistema: sem deslocamentos nem loops"
  },
  "symbol": {
    "viewBox": "0 0 120 120",
    "sun":     { "type": "circle", "cx": 60, "cy": 44, "r": 14, "color": "menta (ou acento do programa)" },
    "horizon": { "type": "path", "d": "M22 80 C 44 70, 76 70, 98 80", "stroke": 12, "cap": "round", "color": "folego / branco sobre azul" },
    "breath":  { "type": "path", "d": "M38 96 C 52 91, 68 91, 82 96", "stroke": 12, "cap": "round", "color": "respiracao" }
  }
}
