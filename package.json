{
  "name": "alento",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Alento — apps para dejar los malos hábitos, día a día: cinco programas (Sem Fumo, Alcohol, Azúcar, Ansiedad, Sueño) con cuestionario, resultados, suscripción Stripe y panel.",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
    "dev": "node --watch --env-file-if-exists=.env server/index.js",
    "stripe:setup": "node --env-file-if-exists=.env scripts/stripe-setup.js",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.js\"",
    "demo": "node scripts/demo.js",
    "content:seed": "node --env-file-if-exists=.env scripts/seed-content.js",
    "db:migrate": "supabase db push --db-url \"$SUPABASE_DB_URL\"",
    "db:migrate:local": "supabase migration up --local",
    "billing:reconcile": "node --env-file-if-exists=.env scripts/reconcile.js",
    "admin:grant": "node --env-file-if-exists=.env scripts/admin-grant.js",
    "growth:staff": "node --env-file-if-exists=.env scripts/growth-staff.js",
    "prod:finish": "node scripts/finish-production.js",
    "access:grant": "node --env-file-if-exists=.env scripts/create-comp-account.js",
    "e2e": "playwright test",
    "stripe:programs": "node --env-file-if-exists=.env scripts/stripe-programs.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "stripe": "^23.0.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@playwright/test": "^1.64.1",
    "supabase": "^2.121.0"
  }
}
