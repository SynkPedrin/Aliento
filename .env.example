# Copia este archivo a .env y completa los valores.
PORT=3000
APP_URL=http://localhost:3000
NODE_ENV=development

# Moneda en la que el usuario indica su gasto semanal en el cuestionario.
APP_CURRENCY=USD
APP_LOCALE=es-US

# Plan destacado en el paywall: semanal | mensual | trimestral
RECOMMENDED_PLAN=trimestral

# Stripe (usa claves de prueba sk_test_ durante el desarrollo)
STRIPE_SECRET_KEY=
# Lo da `stripe listen --forward-to localhost:3000/api/stripe/webhook` o el panel de Stripe
STRIPE_WEBHOOK_SECRET=
# Opcional: IDs de precio explícitos. Si se dejan vacíos se usan los lookup_keys
# creados por `npm run stripe:setup` (folego_semanal, folego_mensual, folego_trimestral).
STRIPE_PRICE_SEMANAL=
STRIPE_PRICE_MENSUAL=
STRIPE_PRICE_TRIMESTRAL=

# Supabase (proyecto gbryzdyawsiaezqysexq). Usar claves ROTADAS; nunca en el código ni en el chat.
# La clave secreta y la cadena de conexión solo se usan en el servidor.
SUPABASE_URL=https://gbryzdyawsiaezqysexq.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Settings → Database → Connection string (modo session/pooler). Necesaria para el servidor y las migraciones.
SUPABASE_DB_URL=

# Oferta de salida: ID del cupón de Stripe (duración "once"). Vacío = sin oferta.
STRIPE_EXIT_COUPON=
EXIT_OFFER_PLAN=semanal

# Precios por programa (lookup keys creados con `npm run stripe:setup` o IDs explícitos).
# Sin valor configurado el plan queda oculto (nunca se muestra un precio inexistente).
STRIPE_PRICE_ANUAL=
STRIPE_PRICE_ALCOHOL_SEMANAL=
STRIPE_PRICE_ALCOHOL_MENSUAL=
STRIPE_PRICE_ALCOHOL_TRIMESTRAL=
STRIPE_PRICE_AZUCAR_SEMANAL=
STRIPE_PRICE_AZUCAR_MENSUAL=
STRIPE_PRICE_AZUCAR_TRIMESTRAL=
STRIPE_PRICE_ANSIEDAD_SEMANAL=
STRIPE_PRICE_ANSIEDAD_MENSUAL=
STRIPE_PRICE_ANSIEDAD_TRIMESTRAL=
STRIPE_PRICE_SUENO_SEMANAL=
STRIPE_PRICE_SUENO_MENSUAL=
STRIPE_PRICE_SUENO_TRIMESTRAL=

# App Store (StoreKit 2): verificación de compras nativas de la app iOS.
# Bundle id de la app (App Store Connect). Sin él, los endpoints de App Store responden 503.
APPLE_BUNDLE_ID=
# Entorno que aceptan las transacciones: production | sandbox (App Review usa sandbox).
APPLE_APP_STORE_ENV=production
# Identificadores de producto por programa/plan; por defecto app.aliento.<programa>.<plan>.
APPLE_PRODUCT_SEM_FUMO_MENSUAL=

# Google Play Billing: verificación servidor a servidor.
# Service account con acceso a Android Publisher y nombre de paquete de la app.
GOOGLE_PLAY_PACKAGE_NAME=
GOOGLE_SERVICE_ACCOUNT_JSON=

# Cron de notificaciones: define SIEMPRE este secreto en producción.
CRON_SECRET=

# Notificaciones push (Web Push). Pueden ser claves de prueba en desarrollo.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:test@example.com
